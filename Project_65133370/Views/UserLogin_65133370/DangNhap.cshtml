
@{
    ViewBag.Title = "DangNhap";
    Layout = "~/Views/Shared/_LayoutGioiThieu.cshtml";
}
<head>
    <link href="~/Content/Style_DangNhap.css" rel="stylesheet"/>
</head>

<div class="login-wrapper">
    <div class="box">
        <h2>Đăng Nhập</h2>

        <form method="post">
            <div class="form-group">
                <label for="username">Tên đăng nhập</label>
                <input type="text" id="username" name="username"
                       class="form-control" placeholder="Nhập email của bạn" required />
            </div>

            <div class="form-group">
                <label for="password">Mật khẩu</label>
                <input type="password" id="password" name="password"
                       class="form-control" placeholder="Password" required />
            </div>

            <button type="submit" class="btn btn-primary btn-login">Đăng nhập</button>
            
            <p style="text-align:center; margin-top:5px;"> 
                @Html.ActionLink("Đăng ký","DangKy","DangKy_65133370")
            </p>

            @if (ViewBag.Error != null)
            {
                <span class="text-danger error-msg">
                    <i class="fa fa-exclamation-triangle"></i> @ViewBag.Error
                </span>
            }
        </form>
    </div>
</div>


