@{
    ViewBag.Title = "CreateLK_BN";
    Layout = "~/Views/Shared/_LayoutBenhNhan.cshtml";
}
<link href="~/Content/Style_DangKyLK.css" rel="stylesheet" />
<input type="hidden" id="hiddenDoctorId" value="@ViewBag.DoctorId" />

<body>
    <div class="content">
        <h1>Đăng ký lịch khám</h1>
        <div class="doc-info" style="display:flex; gap:20px; margin-bottom: 20px; padding: 15px; background: #fff; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
            <div class="img">
                <img src="~/Img/icon/doc-m.jpg" style="max-block-size:100px; border-radius: 50%;" />
            </div>
            <div>
                <h5 class="card-title" style="margin-top:0;">BS. @ViewBag.hoBs @ViewBag.tenBs</h5>
                <p class="card-text"><strong>Chuyên khoa:</strong> @ViewBag.tenKhoa</p>
                <p class="card-text"><strong>Email:</strong> @ViewBag.email</p>
                <p class="card-text"><strong>SĐT:</strong> @ViewBag.soLienLac</p>
            </div>
        </div>
        <div class="date-picker">
            <label for="booking-date">Chọn ngày khám:</label>
            <input type="date" id="booking-date">
        </div>
        <h3>Chọn khung giờ:</h3>
        <div class="time-slot-container"></div>
        <div style="margin-top: 20px;">
            <label for="booking-reason"><strong>Lý do khám:</strong></label>
            <textarea id="booking-reason" style="width:100%; height:80px; padding:10px;" placeholder="Nhập triệu chứng hoặc lý do..."></textarea>
        </div>
        <div class="booked-slots-container" style="display:none;"></div>
    </div>
    <div id="confirmation-modal" class="modal hidden">
        <div class="modal-content">
            <h3>Xác nhận đặt lịch</h3>
            <p id="selected-slot"></p>
            <p><strong>Lý do:</strong> <span id="confirm-reason-text"></span></p>
            <button id="confirm-btn" class="btn">Xác nhận</button>
            <button id="cancel-btn" class="btn cancel">Hủy</button>
        </div>
    </div>
    <div>
        @Html.ActionLink("Trở lại","IndexBS_BN","BacSi_65133370",null,new { @class = "btn btn-success btn-sm btn-block" })
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const timeSlotContainer = document.querySelector(".time-slot-container");
            const modal = document.getElementById("confirmation-modal");
            const selectedSlotDisplay = document.getElementById("selected-slot");
            const confirmReasonText = document.getElementById("confirm-reason-text");
            const confirmBtn = document.getElementById("confirm-btn");
            const cancelBtn = document.getElementById("cancel-btn");
            const datePicker = document.getElementById("booking-date");
            const reasonInput = document.getElementById("booking-reason");
            const doctorId = document.getElementById("hiddenDoctorId").value;

            // Danh sách giờ cố định
            const timeSlots = [

                "9:00 AM", "9:30 AM", "10:00 AM", "10:30 AM",
                "11:00 AM", "11:30 AM", "12:00 PM", "12:30 PM",
                "1:00 PM", "1:30 PM", "2:00 PM", "2:30 PM",
                "3:00 PM", "3:30 PM", "4:00 PM", "4:30 PM",
            ];
            let selectedSlot = null;
            let selectedDate = null;
            // Hàm render các slot giờ
            function renderTimeSlots(date, bookedSlots = []) {
                timeSlotContainer.innerHTML = "";
                timeSlots.forEach((slot) => {
                    const slotDiv = document.createElement("div");
                    slotDiv.classList.add("time-slot");
                    // Kiểm tra xem giờ này có nằm trong danh sách đã đặt từ Server không
                    // API trả về string giờ, ta so sánh chuỗi
                    const isBooked = bookedSlots.includes(slot);
                    if (isBooked) {
                        slotDiv.classList.add("booked");
                        slotDiv.textContent = `${slot} (Đã kín)`;
                        slotDiv.style.backgroundColor = "#e74c3c"; // Màu đỏ
                        slotDiv.style.color = "white";
                        slotDiv.style.cursor = "not-allowed";
                        slotDiv.style.opacity = "0.7";
                    } else {
                        slotDiv.textContent = slot;
                        slotDiv.classList.add("available");
                        // Chỉ cho phép click nếu chưa đặt
                        slotDiv.addEventListener("click", () => selectSlot(slot, slotDiv));
                    }
                    timeSlotContainer.appendChild(slotDiv)
                });
            }
            // Xử lý khi người dùng chọn 1 ô giờ
            function selectSlot(slot, element) {
                const reason = reasonInput.value.trim();
                if (!selectedDate) {
                    alert("Vui lòng chọn ngày trước.");
                    return;
                }
                // Highlight ô được chọn
                document.querySelectorAll(".time-slot").forEach((slotEl) => {
                    if (!slotEl.classList.contains("booked")) slotEl.classList.remove("selected");
                });
                element.classList.add("selected");
                selectedSlot = slot;
                // Hiển thị Modal xác nhận
                selectedSlotDisplay.textContent = `Thời gian: ${slot} - Ngày: ${selectedDate}`;
                confirmReasonText.textContent = reason ? reason : "(Không có lý do)";
                modal.classList.remove("hidden");
            }
            // Sự kiện nút Xác Nhận trong Modal
            confirmBtn.addEventListener("click", () => {
                const reason = reasonInput.value.trim();
                if (selectedSlot && selectedDate) {
                    // Tạo object dữ liệu gửi về Controller
                    const bookingData = {
                        BacSiId: doctorId,
                        NgayKham: selectedDate,
                        GioKham: selectedSlot,
                        LyDoKham: reason
                    };
                    // Gọi AJAX POST về Server
                    $.ajax({
                        url: '/LichKham_65133370/BookAppointment', // Đảm bảo đúng tên Controller
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(bookingData),
                        success: function (response) {
                            if (response.success) {
                                alert(response.message);
                                modal.classList.add("hidden");
                                reasonInput.value = ""; // Xóa lý do
                                // Load lại slot để cập nhật ô vừa đặt thành màu đỏ
                                fetchBookedSlots(selectedDate);
                            } else {
                                alert("Lỗi: " + response.message);
                            }
                        },
                        error: function (err) {
                            console.log(err);
                            alert("Có lỗi xảy ra khi kết nối server.");
                        }
                    });
                }
            });
            // Đóng Modal
            cancelBtn.addEventListener("click", () => {
                modal.classList.add("hidden");
            });
            // Khi thay đổi ngày -> Gọi Server lấy danh sách giờ đã đặt
            datePicker.addEventListener("change", (e) => {
                selectedDate = e.target.value;
                if (selectedDate) {
                    fetchBookedSlots(selectedDate);
                } else {
                    timeSlotContainer.innerHTML = "";
                }
            });
            // Hàm gọi API lấy giờ đã đặt (GET)
            function fetchBookedSlots(date) {
                $.ajax({
                    url: '/LichKham_65133370/GetBookedSlots',
                    type: 'GET',
                    data: { doctorId: doctorId, date: date },
                    success: function (bookedData) {
                        // bookedData là mảng các giờ đã đặt ["9:00 AM", "10:00 AM"]
                        renderTimeSlots(date, bookedData);
                    },
                    error: function () {
                        console.log("Không thể tải dữ liệu lịch đặt.");
                        renderTimeSlots(date, []); // Nếu lỗi thì coi như trống hết
                    }
                });
            }
        });
    </script>

</body>