@model Project_65133370.Models.benhAn

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_LayoutBacSi.cshtml";
}
<link href="~/Content/Style_ThongTinCTBN_BA.css" rel="stylesheet"/>
<div class="container-layout">

    <div class="sidebar-left">
        <div class="profile-header">
            <div class="avatar-box">
                @if (Model.benhNhan != null && !string.IsNullOrEmpty(Model.benhNhan.tenBn))
                {
                    <span>@Model.benhNhan.tenBn.Substring(0, 1)</span>
                }
                else
                {
                    <span>BN</span>
                }
            </div>
            <div class="user-name">
                @Html.DisplayFor(model => model.benhNhan.hoBn) @Html.DisplayFor(model => model.benhNhan.tenBn)
            </div>
            <div class="user-role">Mã BN: @Html.DisplayFor(model => model.benhNhan.maSo)</div>
        </div>

        <div class="profile-details">
            <h5 style="margin-bottom:15px; color:#333;">Thông tin cá nhân</h5>
            <div class="detail-item">
                <span class="lbl">Ngày sinh:</span>
                <span class="val">@Html.DisplayFor(model => model.benhNhan.ngaySinh)</span>
            </div>

            <div class="detail-item">
                <span class="lbl">Số điện thoại:</span>
                <span class="val">@Html.DisplayFor(model => model.benhNhan.soLienLac)</span>
            </div>

            <div class="detail-item">
                <span class="lbl">Ngày khám:</span>
                <span class="val" style="color:#d9534f; font-weight:bold;">
                    @Html.DisplayFor(model => model.ngayKham)
                </span>
            </div>

            <div style="margin-top:20px; text-align:center;">
                @Html.ActionLink("Quay lại", "Details", "BenhNhan_65133370", new { id = Model.benhNhan.maSo }, new { @class = "btn btn-default btn-sm btn-block" })
            </div>
        </div>
    </div>


    <div class="right-stack">

        <div class="info-card">
            <div class="card-title">
                <span>1. Triệu chứng lâm sàng</span>
                <i class="fa fa-stethoscope text-muted"></i>
            </div>
            <div class="card-content">
                @if (!string.IsNullOrEmpty(Model.trieuChung))
                {
                    @Model.trieuChung
                }
                else
                {
                    <em>Chưa ghi nhận triệu chứng.</em>
                }
            </div>
        </div>

        <div class="info-card">
            <div class="card-title">
                <span>2. Chẩn đoán & Kết luận</span>
                <i class="fa fa-user-md text-muted"></i>
            </div>
            <div class="card-content">
                <p><strong>Bệnh chính:</strong> <span style="color:#d9534f; font-weight:bold;">@Html.DisplayFor(model => model.tenBenh.tenBenh1)</span></p>
                <p><strong>Kết luận:</strong> @Html.DisplayFor(model => model.chuanDoan)</p>

                <div class="doctor-signature">
                    Bác sĩ điều trị:<br>
                    <span class="doctor-name-highlight">
                        @if (Model.bacSi != null)
                        {
                            @: @Model.bacSi.hoBs @Model.bacSi.tenBs
                        }
                    </span>
                </div>
            </div>
        </div>

        <div class="info-card">
            <div class="card-title">
                <span>3. Đơn thuốc</span>
                <i class="fa fa-medkit text-muted"></i>
            </div>
            <div class="card-content">
                @if (!string.IsNullOrEmpty(Model.maDonThuoc))
                {

                    if (Model.donThuoc != null && Model.donThuoc.chiTietDonThuocs != null && Model.donThuoc.chiTietDonThuocs.Count > 0)
                    {
                        <table class="table table-bordered table-striped" style="font-size: 0.9rem; margin-top:10px;">
                            <thead style="background-color: #f0f2f5;">
                                <tr>
                                    <th>Tên thuốc</th>
                                    <th class="text-center">SL</th>
                                    <th class="text-right">Đơn giá</th>
                                    <th class="text-right">Thành tiền</th>
                                    <th>Liều dùng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.donThuoc.chiTietDonThuocs)
                                {
                                    var donGia = item.thuoc.donGia;
                                    var thanhTienThuoc = (item.soLuong) * (donGia);
                                    <tr>
                                        <td><strong>@(item.thuoc.tenThuoc)</strong></td>
                                        <td class="text-center">@item.soLuong</td>
                                        <td class="text-right">@string.Format("{0:N0}", donGia)</td>
                                        <td class="text-right" style="color:#007bff; font-weight:bold;">@string.Format("{0:N0}", thanhTienThuoc)</td>
                                        <td>@item.lieuDung</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-warning" style="margin-top:10px;">
                            Đơn thuốc <strong>@Model.maDonThuoc</strong> đã được tạo nhưng chưa có thuốc.
                            <br />Vui lòng nhấn nút bên dưới để kê thuốc.
                        </div>
                    }
                    <div class="text-right" style="margin-top:10px;">
                        @Html.ActionLink("Cập nhật Đơn Thuốc", "Create", "ChiTietDonThuoc_65133370",
                            new { id = Model.maBenhAn },
                            new { @class = "btn btn-primary btn-sm" })

                    </div>
                }
                else
                {
                    <p>
                        @Html.ActionLink("Tạo đơn thuốc", "IndexTaoDon", "DonThuoc_65133370",
                            new { id = Model.maBenhAn },
                            new { @class = "btn btn-success btn-xs" })
                    </p>
                }
            </div>
        </div>
        <div class="info-card">
            <div class="card-title">
                <span>4. Hóa đơn & Thanh toán</span>
                <i class="fa fa-credit-card text-muted"></i>
            </div>
            <div class="card-content">
                @{
                    double tongTienThuoc = 0;
                    double tongTienDichVu = 0;
                    if (Model.donThuoc != null && Model.donThuoc.chiTietDonThuocs != null)
                    {
                        tongTienThuoc = Model.donThuoc.chiTietDonThuocs.Sum(x => (double)((x.soLuong ?? 0) * (x.thuoc.donGia ?? 0)));
                    }

                    var hoaDon = Model.hoaDons != null ? Model.hoaDons.FirstOrDefault() : null;
                    if (hoaDon != null && hoaDon.chiTietHoaDons != null)
                    {
                        tongTienDichVu = hoaDon.chiTietHoaDons.Sum(x => (double)(x.DichVu.giaTien));
                    }
                    double tongCong = tongTienThuoc + tongTienDichVu;
                }

                @if (hoaDon != null)
                {
                    <div style="background-color: #fff3cd; padding: 15px; border-radius: 5px; border: 1px solid #ffeeba;">
                        <div class="row">
                            <div class="col-xs-8">Tiền dịch vụ (Khám/Siêu âm...):</div>
                            <div class="col-xs-4 text-right">@string.Format("{0:N0} đ", tongTienDichVu)</div>
                        </div>
                        <div class="row">
                            <div class="col-xs-8">Tiền thuốc:</div>
                            <div class="col-xs-4 text-right">@string.Format("{0:N0} đ", tongTienThuoc)</div>
                        </div>
                        <hr style="margin: 10px 0; border-top: 1px dashed #856404;">
                        <div class="row" style="font-size: 1.2rem; font-weight: bold; color: #d9534f;">
                            <div class="col-xs-6">TỔNG CỘNG:</div>
                            <div class="col-xs-6 text-right">@string.Format("{0:N0} đ", tongCong)</div>
                        </div>
                    </div>

                    <div style="margin-top: 15px; display:flex; justify-content:space-between; align-items:center;">
                        <div>
                            Trạng thái:
                            @if (hoaDon.trangThaiThanhToan == true)
                            {
                                <span class="label" style="color:lawngreen;">Đã thanh toán</span>
                            }
                            else
                            {
                                <span class="label" style="color:red;">Chờ thanh toán</span>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        Chưa lập hóa đơn cho bệnh án này.
                        <br />
                        <strong>Tạm tính: @string.Format("{0:N0} đ", tongCong)</strong> (Thuốc + Dịch vụ)
                    </div>
                    @Html.ActionLink("Tạo hóa đơn", "Create", "HoaDon_65133370",
                            new { maBenhAn = Model.maBenhAn },
                            new { @class = "btn btn-warning btn-sm" })
                }
            </div>
        </div>
    </div>