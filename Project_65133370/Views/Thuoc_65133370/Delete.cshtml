@model Project_65133370.Models.thuoc

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_LayoutBacSi.cshtml";
}

<h2>Xóa</h2>

<h3 style="color:red;">Bạn có chắc chắn muốn xóa thuốc này?</h3>
<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            Tên thuốc
        </dt>

        <dd>
            @Html.DisplayFor(model => model.tenThuoc)
        </dd>

        <dt>
            Đơn giá
        </dt>

        <dd>
            @Html.DisplayFor(model => model.donGia)
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Delete" class="btn btn-default" /> |
            @Html.ActionLink("Trở về", "Index")
        </div>
    }
</div>
