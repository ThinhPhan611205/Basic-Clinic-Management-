@model IEnumerable<Project_65133370.Models.thuoc>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="doc-info"
    style="gap:20px; margin-bottom: 20px; padding: 15px; background: #fff; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
    <h2>Danh sách thuốc</h2>

    <div style="margin-bottom: 20px; padding: 15px; background: #f8f9fa; border-radius: 5px;">
        @using (Html.BeginForm("TimKiemThuoc", "Thuoc_65133370", FormMethod.Get))
        {
            <div class="row">
                <div class="col-md-4">
                    <label>Mã thuốc:</label>
                    <input type="text" name="maThuoc" value="@ViewBag.maThuoc" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label>Tên thuốc:</label>
                    <input type="text" name="tenThuoc" value="@ViewBag.tenThuoc" class="form-control" />
                </div>
                <div class="col-md-4" style="padding-top: 25px;">
                    <input type="submit" value="Tìm kiếm" class="btn btn-primary" />
                    <a href="@Url.Action("Index", "Thuoc_65133370")" class="btn btn-secondary">Nhập mới</a>
                </div>
            </div>
        }
    </div>

    <p>
        @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
    </p>
    <table class="table">
        <tr>
            <th>Mã thuốc</th>
            <th>Tên thuốc</th>
            <th>Đơn giá</th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.maThuoc)</td>
                <td>@Html.DisplayFor(modelItem => item.tenThuoc)</td>
                <td>@Html.DisplayFor(modelItem => item.donGia)</td>
                <td>
                    @Html.ActionLink("Sửa", "Edit", new { id = item.maThuoc }) |
                    @Html.ActionLink("Xóa", "Delete", new { id = item.maThuoc })
                </td>
            </tr>
        }

    </table>

</div>
