@model IEnumerable<Project_65133370.Models.bacSi>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="doc-info"
    style="gap:20px; margin-bottom: 20px; padding: 15px; background: #fff; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
    <h2>Danh sách bác sĩ</h2>

    <div style="margin-bottom: 20px; padding: 15px; background: #f8f9fa; border-radius: 5px;">
        @using (Html.BeginForm("TimKiemBacSi", "BacSi_65133370", FormMethod.Get))
        {
            <div class="row">
                <div class="col-md-3">
                    <label>Mã bác sĩ:</label>
                    <input type="text" name="maBS" value="@ViewBag.maBS" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label>Họ tên:</label>
                    <input type="text" name="hoTen" value="@ViewBag.hoTen" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label>Chuyên khoa:</label>
                    <input type="text" name="chuyenKhoa" value="@ViewBag.chuyenKhoa" class="form-control" />
                </div>
                <div class="col-md-3" style="padding-top: 25px;">
                    <input type="submit" value="Tìm kiếm" class="btn btn-primary" />
                    <a href="@Url.Action("Index", "BacSi_65133370")" class="btn btn-secondary">Nhập mới</a>
                </div>
            </div>
        }
    </div>

    <p>
        @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
    </p>
    <table class="table">
        <tr>
            <th>Mã BS</th>
            <th>Họ BS</th>
            <th>Tên BS</th>
            <th>Ngày sinh</th>
            <th>SDT</th>
            <th>EMAIL</th>
            <th>Chức vụ</th>
            <th>USERN</th>
            <th>PASSW</th>
            <th>IDR</th>
            <th>Chuyên khoa</th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.ID)</td>
                <td>@Html.DisplayFor(modelItem => item.hoBs)</td>
                <td>@Html.DisplayFor(modelItem => item.tenBs)</td>
                <td>@Html.DisplayFor(modelItem => item.ngaySinh)</td>
                <td>@Html.DisplayFor(modelItem => item.soLienLac)</td>
                <td>@Html.DisplayFor(modelItem => item.email)</td>
                <td>@Html.DisplayFor(modelItem => item.chucVu)</td>
                <td>@Html.DisplayFor(modelItem => item.userN)</td>
                <td>@Html.DisplayFor(modelItem => item.passW)</td>
                <td>@Html.DisplayFor(modelItem => item.Role.IDR)</td>
                <td>@Html.DisplayFor(modelItem => item.chuyenKhoa.tenKhoa)</td>
                <td>
                    @Html.ActionLink("Sửa", "Edit", new { id = item.ID }) |
                    @Html.ActionLink("Xóa", "Delete", new { id = item.ID })
                </td>
            </tr>
        }

    </table>
</div>
