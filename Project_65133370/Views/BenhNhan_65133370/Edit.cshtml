                    @Html.EditorFor(model => model.passW, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.passW, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.IDR, "Mã vai trò ( 1: Admin | 2: Bệnh nhân | 3: Bác sĩ )", htmlAttributes: new { @class = "control-label col-md-8" })
                <div class="col-md-10">
                    @Html.DropDownList("IDR", null, htmlAttributes: new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.IDR, "", new { @class = "text-danger" })
                </div>
            </div>
            <div style="display:flex; margin-top:20px; gap:20px;">
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-2">
                        <input type="submit" value="Save" class="btn btn-success" />
                    </div>
                </div>

                <div>
                    @Html.ActionLink("Quay lại", "Details", null, new { id = Model.maSo }, new { @class = "btn btn-primary" })
                </div>
            </div>
            
        </div>
    }
</div>
