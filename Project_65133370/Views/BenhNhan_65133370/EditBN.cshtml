@model Project_65133370.Models.benhNhan
@{
    ViewBag.Title = "EditBN";
    Layout = "~/Views/Shared/_LayoutBenhNhan.cshtml";
}


@using (Html.BeginForm("EditBN", "BenhNhan_65133370", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Chỉnh sửa thông tin tài khoản</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.maSo)

        <div class="form-group">
            @Html.LabelFor(model => model.hoBn,"Họ bệnh nhân",htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.hoBn, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.hoBn, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.tenBn,"Tên bệnh nhân", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.tenBn, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.tenBn, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.ngaySinh,"Ngày sinh" ,htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.ngaySinh, new { htmlAttributes = new { @class = "form-control" , @type="date"} })
                @Html.ValidationMessageFor(model => model.ngaySinh, "", new { @class = "text-danger"  })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.soLienLac,"Số liên lạc", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.soLienLac, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.soLienLac, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.userN,"Tên đăng nhập", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.userN, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.userN, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.passW,"Mật khẩu", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.passW, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.passW, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group" style="display:flex; gap:10px; margin-top:20px;">
            <div class="col-md-offset-2 col-md-1">
                <input type="submit" value="Save" class="btn btn-success"  />
            </div>
            <div>
                @Html.ActionLink("Quay lại", "ThongTinCTBN", new { id = Model.maSo }, new { @class = "btn btn-xs btn-primary" })
            </div>
        </div>
    </div>
}




