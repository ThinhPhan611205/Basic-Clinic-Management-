@model Project_65133370.Models.benhNhan

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_LayoutBacSi.cshtml";
}
<div class="form-horizontal" style="background:#fff; padding:20px; border-radius:5px; box-shadow:0 0 10px rgba(0,0,0,0.1);">
    <h2 style="color:red;">Bạn có chắc chắn muốn xóa bệnh nhân này?</h2>
    <div>
        <h4>Thông tin bệnh nhân</h4>
        <hr />
        <dl class="dl-horizontal">
            <dt>
                Họ bệnh nhân
            </dt>

            <dd>
                @Html.DisplayFor(model => model.hoBn)
            </dd>

            <dt>
                Tên bệnh nhân
            </dt>

            <dd>
                @Html.DisplayFor(model => model.tenBn)
            </dd>

            <dt>
                Ngày sinh
            </dt>

            <dd>
                @Html.DisplayFor(model => model.ngaySinh)
            </dd>

            <dt>
                Số liên lạc
            </dt>

            <dd>
                @Html.DisplayFor(model => model.soLienLac)
            </dd>

            <dt>
                Tên đăng nhập
            </dt>

            <dd>
                @Html.DisplayFor(model => model.userN)
            </dd>

            <dt>
                Mật khẩu
            </dt>

            <dd>
                @Html.DisplayFor(model => model.passW)
            </dd>

            <dt>
                Mã vai trò
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Role.IDR)
            </dd>

        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions no-color">
                <input type="submit" value="Delete" class="btn btn-danger" /> |
                @Html.ActionLink("Trở về", "IndexBN_BS", null, new { @class = "btn btn-primary" })
            </div>
        }
    </div>
</div>

